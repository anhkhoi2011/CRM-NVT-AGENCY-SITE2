# Sao chép thành .env trong Application Root trên hosting; không commit file .env thật.
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpanel_database_user
DB_PASSWORD=replace_with_database_password
DB_NAME=cpanel_database_name
DB_CONNECTION_LIMIT=60

# CPanel/Passenger thường tự cấp PORT; không đặt PORT trên hosting nếu cPanel đã quản lý.
HOST=0.0.0.0
# PORT=4173

# Bật token cho webhook Landing Page nếu bên gửi hỗ trợ header x-api-key.
WEBHOOK_TOKEN=replace_with_random_webhook_token
WEBHOOK_DATA_DIR=/home/gdyeksti/webhook-data

# Telegram system bot: account linking, data, attendance and agency notices.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=HeThongCRMNVT_BOT
# Chat ID cua Admin nhan data, diem danh va thong bao he thong.
TELEGRAM_ADMIN_CHAT_ID=
# Telegram support bot: chi dung cho tin nhan Sale -> Admin trong Mini Inbox.
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_BOT_USERNAME=HotroTinNhanCRM_bot
TELEGRAM_SUPPORT_ADMIN_CHAT_ID=
# Moi bot co webhook rieng; secret la chuoi ngau nhien, khong phai token bot.
TELEGRAM_WEBHOOK_URL=https://crm.example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret
TELEGRAM_SUPPORT_WEBHOOK_URL=https://crm.example.com/api/telegram/support-webhook
TELEGRAM_SUPPORT_WEBHOOK_SECRET=replace_with_another_long_random_secret

# Thu muc luu anh chat ho tro, nam ngoai public web va chi tra qua API da xac thuc.
# SUPPORT_UPLOAD_DIR=/home/cpanel_user/crm-support-uploads

# Tùy chọn gửi email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CRM_EMAIL_TOKEN=

# Giới hạn kết nối tính theo mỗi process; worker Telegram dùng pool riêng nhỏ hơn.
DB_AUTH_CONNECTION_LIMIT=25
DB_QUEUE_LIMIT=0
DB_AUTH_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=5000
DB_ACQUIRE_TIMEOUT=5000
DB_QUERY_TIMEOUT=5000

# Mặc định web tự tạo worker Telegram riêng.
RUN_TELEGRAM_SCHEDULER=0
RUN_TELEGRAM_WORKER=1
TELEGRAM_WORKER_DB_LIMIT=4
# Watchdog chạy bằng Cron, độc lập với process web. Passenger có thể dùng Unix socket.
# WATCHDOG_URL=https://your-crm-domain/api/health/live
# WATCHDOG_SOCKET=/duong-dan/socket-thuc-te

# Realtime SSE (mặc định tắt). Kết nối mở lâu dễ chiếm hết slot của hosting chia sẻ;
# CRM dùng polling 15 giây. Chỉ bật (=1) khi hosting cho phép nhiều kết nối đồng thời.
ENABLE_SSE=0

# API chỉ đọc cho Marketing. Khóa riêng, thay giá trị này để thu hồi khóa cũ.
CRM_API_KEY=
